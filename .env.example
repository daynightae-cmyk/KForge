# KNOuX Forge server environment
# Set these in the process environment. The production server does not load this
# file automatically.

# Parent directory whose immediate child repositories KForge discovers.
KFORGE_WORKSPACE_ROOT=.

# Production HTTP port used by `npm start`. Vite development uses port 8080.
PORT=3000

# Optional explicit local security-tool executable paths.
# KFORGE_GITLEAKS_PATH=C:\Tools\gitleaks.exe
# KFORGE_SEMGREP_PATH=C:\Tools\semgrep.exe
# KFORGE_SONAR_PATH=C:\Tools\sonar-scanner.bat
# KFORGE_NPM_PATH=C:\Program Files\nodejs\npm.cmd

# Optional cloud AI providers. A provider is NOT_CONFIGURED until both its
# server-side credential and explicit model are set. KForge never exposes these
# credentials to the renderer, never auto-selects cloud, and requires a per-
# request disclosure confirmation before project context is transmitted.
# OPENAI_API_KEY=
# KFORGE_OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# KFORGE_ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# KFORGE_GEMINI_MODEL=
# OPENROUTER_API_KEY=
# KFORGE_OPENROUTER_MODEL=
