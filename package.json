{
  "name": "knoux-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first engineering command center for verified project workflows.",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "author": "DAY NIGHT DELIVERY SERVICES",
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true
  },
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*",
      "fixtures/marketplace-first-party/**/*",
      "fixtures/marketplace-first-party-v110/**/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "lint": "node scripts/lint.mjs",
    "test:e2e": "playwright test",
    "verify:assets": "node scripts/verify-asset-budget.mjs",
    "verify:gate": "node scripts/verify-gate.mjs",
    "verify:desktop": "npm run build && node scripts/verify-desktop.mjs",
    "verify:signing": "node scripts/verify-signing.mjs",
    "verify:release": "npm run verify:assets && npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && node scripts/verify-desktop.mjs && node scripts/package-windows.mjs && npm run verify:installer",
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "verify:installer": "powershell -ExecutionPolicy Bypass -File installer/verify-installer.ps1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "three": "0.186.1",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@swc/core": "^1.16.18",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.104.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "globals": "^15.15.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "7.18.4",
    "serverless-http": "^3.2.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "vaul": "^0.9.9",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "express-rate-limit": {
      "ip-address": "10.7.4"
    },
    "tailwindcss": {
      "chokidar": {
        "anymatch": {
          "picomatch": "2.3.2"
        },
        "readdirp": {
          "picomatch": "2.3.2"
        }
      },
      "fast-glob": {
        "micromatch": {
          "picomatch": "2.3.2"
        }
      },
      "micromatch": {
        "picomatch": "2.3.2"
      }
    }
  },
  "build": {
    "appId": "com.daynightdeliveryservices.knouxforge",
    "productName": "KNOuX Forge",
    "artifactName": "KNOuX-Forge-Setup-v${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "fixtures/marketplace-first-party/**",
      "fixtures/marketplace-first-party-v110/**",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "installer/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KNOuX Forge",
      "uninstallDisplayName": "KNOuX Forge",
      "include": "installer/installer-custom.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "KNOuX-Forge-Setup-v${version}-Windows-${arch}.${ext}"
    }
  }
}
